@{ ViewData["Title"] = "Your bag"; }
<div class="shell cart-page"><p class="eyebrow">YOUR EVERYDAY, ELEVATED</p><h1>Your bag<span class="muted">.</span></h1><div class="cart-layout"><section aria-label="Products in your bag"><div id="cart-items"></div><div id="empty-cart" class="empty-state" hidden><h2>Good things are waiting.</h2><p>Explore the collection and find your next everyday essential.</p><a class="button button-dark" asp-action="Index" asp-fragment="collection">Explore the collection ↗</a></div></section><aside class="cart-summary"><h2>A little closer to extraordinary.</h2><div><span>Subtotal</span><strong id="cart-subtotal">€0.00</strong></div><div><span>Currency</span><span>EUR</span></div><hr /><p>This storefront currently supports a saved shopping bag. Checkout, payments and delivery are not available yet.</p><a class="button button-dark" asp-action="Index" asp-fragment="collection">Continue exploring ↗</a><button type="button" id="clear-cart" class="text-link">Empty bag</button><p class="small" id="storage-notice">Your bag is stored only in this browser.</p></aside></div><noscript><p>Enable JavaScript to view and update your shopping bag.</p></noscript></div>