@model IReadOnlyList<Product>
@{ ViewData["Title"] = "Everyday, elevated"; }
<div class="shell">
<section class="hero" aria-labelledby="hero-title"><div class="hero-copy"><p class="eyebrow"><span class="tiny-line"></span> THE ART OF EVERYDAY</p><h1 id="hero-title">Less ordinary.<br />More <em>extraordinary.</em></h1><p>Beautiful technology. Considered essentials.<br />Discover the things that make every day better.</p><a href="#collection" class="button button-dark">Explore the collection <span>↗</span></a><div class="hero-proof"><span class="star-row" aria-hidden="true">★★★★★</span><span>Exceptional products. Loved by thousands.</span></div></div><div class="hero-visual"><span class="hero-edition">THE SOUND OF SOMETHING BETTER</span><img src="~/images/sony-wh1000xm5.jpg" alt="Sony WH-1000XM5 wireless headphones" fetchpriority="high" width="700" height="700" /><a class="hero-caption" asp-action="Details" asp-route-id="5"><span>Sony WH-1000XM5<small>Find your quiet. Feel every note.</small></span><span class="round-arrow">↗</span></a><span class="edition-number">01 / THE EVERYDAY EDIT</span></div></section>
<section class="value-strip" id="shopping-info" aria-label="Shopping information"><div><span class="line-symbol">↗</span><span><strong>Designed to go further</strong><small>Technology that fits your everyday</small></span></div><div><span class="line-symbol">◇</span><span><strong>Only the exceptional</strong><small>A carefully considered selection</small></span></div><div><span class="line-symbol">€</span><span><strong>Clarity, always</strong><small>All prices displayed in EUR</small></span></div><div><span class="line-symbol">＋</span><span><strong>Your own little collection</strong><small>Your bag stays saved on this device</small></span></div></section>
<section class="section-block" aria-labelledby="category-title"><div class="section-heading"><div><p class="eyebrow">FIND YOUR EVERYDAY</p><h2 id="category-title">A world of possibilities.</h2></div><a href="#collection" class="text-link">Shop the collection ↗</a></div><div class="category-grid">@foreach(var item in new[] { ("Audio", "sony-wh1000xm5.jpg", "For your own rhythm"), ("Laptops", "macbook-air-m4.jpg", "For your next big idea"), ("Smartphones", "iphone16.jpg", "For life on the move"), ("Gaming", "ps5-slim.jpg", "For a little escape") }){<a class="category-tile" href="?category=@item.Item1#collection"><img src="~/images/@item.Item2" alt="" loading="lazy" width="300" height="260" /><div><small>@item.Item3</small><h3>@item.Item1 <span>↗</span></h3></div></a>}</div></section>
<section class="section-block best-section" id="bestsellers"><div class="section-heading"><div><p class="eyebrow">THE CROWD FAVORITES</p><h2>Well loved. For good reason.</h2></div><span class="section-note">Our best-seller edit, just for you.</span></div><div class="product-grid best-grid">@foreach(var product in Model.Where(p => p.Badge == "Best Seller")){<partial name="_ProductCard" model="product" />}</div></section>
<section class="editorial" id="our-story"><div><p class="eyebrow">THE FORME PHILOSOPHY</p><h2>Good things.<br /><em>Chosen with intention.</em></h2></div><div><p>We believe the things you surround yourself with should earn their place. Through thoughtful design. Through effortless function. Through the way they make you feel.</p><p>So we keep our collection small, and our standards high. A few exceptional things. A better everyday.</p><a class="text-link" href="#collection">Find your next favorite ↗</a></div></section>
<section class="section-block" id="collection" aria-labelledby="collection-title"><div class="section-heading"><div><p class="eyebrow">CONSIDERED FROM EVERY ANGLE</p><h2 id="collection-title">The collection.</h2></div><span class="section-note">Great design meets everyday life.</span></div><div class="collection-toolbar"><div class="filter-list" role="group" aria-label="Filter products by category"><button type="button" class="filter active" data-filter="" aria-pressed="true">All products</button>@foreach(var category in Model.Select(p=>p.Category).Distinct()){<button type="button" class="filter" data-filter="@category" aria-pressed="false">@category</button>}</div><label class="sort-label">Sort by <select id="product-sort"><option value="featured">Featured</option><option value="price-asc">Price: low to high</option><option value="price-desc">Price: high to low</option><option value="rating">Top rated</option><option value="name">Name: A–Z</option></select></label></div><div class="results-line"><span id="results-count" role="status" aria-live="polite">Showing @Model.Count products</span><button type="button" class="text-link" id="clear-filters">Reset filters</button></div><div class="product-grid" id="product-grid">@foreach(var product in Model){<partial name="_ProductCard" model="product" />}</div><div class="empty-state" id="no-results" hidden><h3>A fresh search?</h3><p>We couldn’t find a match. Try another name, brand or category.</p></div></section>
<div class="closing-note"><span class="eyebrow">THOUGHTFULLY SELECTED. READY FOR YOUR EVERYDAY.</span><p>Find your <em>forme.</em></p></div>
</div>