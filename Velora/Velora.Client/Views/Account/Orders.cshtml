@model List<Velora.Contracts.OrderReceipt>
@using System.Globalization
@{ ViewData["Title"] = "My orders"; }
<div class="shell account-page"><a asp-action="Profile" class="text-link">Back to your account</a><h1>My orders.</h1>
    <p>Orders placed while you are signed in appear here. Previous guest orders remain available through their private confirmation links.</p>
    @if (Model.Count == 0) { <p>You have no account orders yet.</p><a asp-controller="Home" asp-action="Index" class="button button-dark">Explore the collection</a> }
    @foreach (var order in Model) {
        <article class="address-card"><h2>@order.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</h2>
            <p>@order.Items.Sum(i => i.Quantity) items · @order.Total.ToString("C", CultureInfo.GetCultureInfo("en-IE")) · @order.Status · @order.PaymentStatus</p>
            <a asp-controller="Checkout" asp-action="Confirmation" asp-route-id="@order.Id" class="text-link">View order</a>
        </article>
    }
</div>
