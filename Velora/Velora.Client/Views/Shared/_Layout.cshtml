@inject Velora.Client.Services.ProductApiClient ProductApi
@{ var products = await ProductApi.GetProductsAsync(Context.RequestAborted); }
@using System.Text.Json
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f3ef" />
    <meta name="description" content="Considered technology for a better everyday. Explore the VELORA collection of premium audio, laptops and essentials." />
    <title>@ViewData["Title"] — VELORA</title>
    <link rel="icon" href="~/favicon.ico" sizes="any" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script id="product-data" type="application/json">@Html.Raw(JsonSerializer.Serialize(products))</script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<div class="announcement">Thoughtfully chosen. Beautifully made. <span>Discover your everyday upgrade →</span></div>
<header class="site-header">
    <div class="shell nav-main">
        <a class="wordmark" asp-controller="Home" asp-action="Index" aria-label="VELORA home">velora<span>®</span></a>
        <form class="nav-search" asp-controller="Home" asp-action="Index" method="get" role="search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><input type="search" name="q" id="nav-search" placeholder="Find your next favorite…" aria-label="Search the collection" /><kbd>/</kbd></form>
        <a class="nav-about" asp-controller="Home" asp-action="Index" asp-fragment="our-story">Our philosophy</a>
        <a class="cart-link" asp-controller="Home" asp-action="Cart" aria-label="Shopping bag"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14l1 14H4L5 7Z"/><path d="M8 8V6a4 4 0 0 1 8 0v2"/></svg><span class="bag-label">Bag</span><span id="cart-count">0</span></a>
    </div>
    <nav class="shell category-nav" aria-label="Main navigation"><a asp-controller="Home" asp-action="Index" asp-fragment="collection">Shop all</a>@foreach(var category in products.Select(p => p.Category).Distinct()){<a asp-controller="Home" asp-action="Index" asp-route-category="@category" asp-fragment="collection">@category</a>}<a class="nav-edit" asp-controller="Home" asp-action="Index" asp-fragment="bestsellers">The best-seller edit ↗</a></nav>
</header>
<main id="main">@RenderBody()</main>
<footer class="site-footer" id="footer"><div class="shell footer-grid"><div><a class="wordmark" asp-controller="Home" asp-action="Index">velora<span>®</span></a><p>Good design. Great technology.<br />A little more extraordinary, every day.</p></div><div><h2>Explore</h2><a asp-controller="Home" asp-action="Index" asp-fragment="collection">The collection</a><a asp-controller="Home" asp-action="Index" asp-fragment="bestsellers">Best sellers</a><a asp-controller="Home" asp-action="Cart">Your bag</a></div><div><h2>About VELORA</h2><a asp-controller="Home" asp-action="Index" asp-fragment="our-story">Our philosophy</a><a asp-controller="Home" asp-action="Privacy">Privacy &amp; storage</a><a asp-controller="Home" asp-action="Index" asp-fragment="shopping-info">Shopping information</a></div><div><h2>A considered collection</h2><p>Ten exceptional products.<br />Selected for the way you live.</p><span class="footer-currency">Europe · EUR €</span></div></div><div class="shell footer-bottom"><span>© @DateTime.Now.Year VELORA. Everyday, elevated.</span><span>Designed with intention.<br/>V1.0.1</span></div></footer>
<div class="toast-message" id="cart-message" role="status" aria-live="polite"></div>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>